# Used both for `yarn dev` and for the dockerized app service (docker-compose reads this file).
# When running locally (yarn dev, MongoDB in Docker):
NUXT_MONGODB_URI=mongodb://admin:password@localhost:27017/bucket-list?authSource=admin

# When running the app via docker-compose, connecting to the local mongodb service:
# NUXT_MONGODB_URI=mongodb://admin:password@mongodb:27017/bucket-list?authSource=admin

MONGO_USER=admin
MONGO_PASSWORD=password

# Random secret used to seal/encrypt session cookies (32+ chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=

# There is no public sign-up page. To create an account, generate a secret below
# and POST to /api/auth/register with header `x-signup-secret: <this value>`.
NUXT_SIGNUP_SECRET=
